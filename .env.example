# Copy to .env: `cp .env.example .env` (or just run `make up`)

# 1 = show error details in API responses, 0 = production
APP_DEBUG=0

# Host port for the web app (nginx)
HTTP_PORT=8080

# PostgreSQL connection (also used to initialise the db container)
DB_HOST=db
DB_PORT=5432
DB_NAME=products
DB_USER=app
DB_PASSWORD=app

# RabbitMQ credentials (the Messenger DSN is assembled from them in docker-compose.yml)
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
# Host port for the RabbitMQ management UI
RABBITMQ_UI_PORT=15672
# Symfony Messenger transport (import queue). Set automatically in docker-compose.yml from
# RABBITMQ_USER/RABBITMQ_PASSWORD. Uncomment only when running PHP outside Docker
# (then also publish port 5672 of the rabbitmq service).
# MESSENGER_TRANSPORT_DSN=amqp://app:app@localhost:5672/%2f/messages

# Auth: the single admin account (login page credentials)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
# HS256 signing key, at least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
