{
    "name": "testovoe/backend",
    "type": "project",
    "require": {
        "php": "^8.3",
        "slim/slim": "^4",
        "slim/psr7": "^1",
        "doctrine/orm": "^3",
        "doctrine/dbal": "^4",
        "doctrine/migrations": "^3",
        "symfony/cache": "^7",
        "php-di/php-di": "^7",
        "symfony/messenger": "^7",
        "symfony/amqp-messenger": "^7",
        "symfony/event-dispatcher": "^7",
        "symfony/http-client": "^7",
        "phpoffice/phpspreadsheet": "^5",
        "symfony/http-foundation": "^7",
        "firebase/php-jwt": "^7",
        "doctrine/data-fixtures": "^2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2",
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan-doctrine": "^2"
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    }
}
